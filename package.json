{
  "name": "heatshift",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests scripts *.json *.ts",
    "format:check": "prettier --check src tests scripts *.json *.ts",
    "evaluate:live": "node --env-file=.env.local --import tsx scripts/evaluate-extraction.ts --live",
    "smoke:live": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
